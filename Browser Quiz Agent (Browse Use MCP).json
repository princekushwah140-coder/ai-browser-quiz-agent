    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Complete the quiz at this URL: {{ $json.url }}",
        "options": {
          "systemMessage": "You control a browser through tools. Goal: complete the quiz at the given URL.\n\nLoop:\n1. browser_navigate to the URL (first step only).\n2. browser_snapshot to read the current question and options.\n3. Reason about the correct answer from the question text. If unsure, pick the most likely option and note low confidence.\n4. Click/select the option, then click Next/Submit.\n5. Use browser_wait_for if the page loads dynamically, then browser_snapshot again to verify the page changed. If not, retry once, then report the blocker.\nComplete the quiz in the selected tab.\n\nRepeat for every question:\n1. take_snapshot.\n2. Click the correct option.\n3. take_snapshot again (new buttons may appear after selecting).\n4. Click the button labelled Next, Submit, Finish, Check, or See results.\n5. take_snapshot again to confirm the page changed.\n\nRules:\n- UIDs change after every snapshot. Never reuse an old uid.\n- Do not stop after selecting an option. A question is finished only\n  when you have clicked the forward or submit button.\n- On the last question, click Submit/Finish, then take a snapshot and\n  report the final score text.\n- If no button is visible, scroll down or press the Tab key and Enter, then re-snapshot.\n- Stop only when a results or score screen is visible.\nStop when a results page appears. Final report: questions answered, your choice for each with confidence, final score if shown.\n\nNever enter credentials. If you hit a login wall or CAPTCHA, stop and report it.",
          "maxIterations": 40
        }
      },
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
